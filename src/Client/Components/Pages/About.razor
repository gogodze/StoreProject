@page "/About"

<PageTitle>About us</PageTitle>

<div class="w-full max-w-screen-xl mx-auto px-4 pt-10 pb-16 flex flex-col gap-10">
    <div class="flex flex-col gap-3 max-w-2xl">
        <h1 class="text-4xl font-bold">About us</h1>
        <p class="text-muted-foreground text-lg">
            We are building Georgia’s go-to online shop — everyday products, fair prices, and delivery you can count on.
        </p>
    </div>

    <div class="flex flex-col gap-4">
        <h2 class="text-2xl font-bold">Our story</h2>
        <p class="text-muted-foreground max-w-3xl leading-relaxed">
            Started in Tbilisi, our store brings together a wide catalog so you can find what you need in one place.
            From household essentials to specialty finds, we focus on a smooth shopping experience and reliable service
            across Georgia.
        </p>
    </div>

    <WhoWeAre/>

    <div class="flex flex-col gap-4 border border-border rounded-md p-6 shadow-md max-w-3xl">
        <h2 class="text-2xl font-bold">Based in Tbilisi</h2>
        <p class="text-muted-foreground">
            13, Ilo Mosashvili Street, Vake, Tbilisi 0162
        </p>
        <a href="/Contact" class="text-[#108a37] font-bold hover:underline underline-offset-4 w-fit">
            Get in touch →
        </a>
    </div>
</div>
