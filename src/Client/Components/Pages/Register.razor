@page "/Register"
@using Application.Users.Commands
@using Client.Auth
@using System.Text.Json
@inject IToastService Toast
@inject NavigationManager Nav
@inject IJSRuntime Js

<div class="flex-1 w-full flex flex-col justify-center items-center px-4 py-10">
    <div class="border rounded-md border-border shadow-md p-12 flex flex-col justify-center gap-2 items-center w-full max-w-lg">
        <h1 class="text-bold text-4xl">Create your account</h1>

        <form class="flex flex-col space-y-2 w-96 mt-4" @onsubmit="OnValidSubmit" @onsubmit:preventDefault>
            <div id="sso-buttons" class="flex w-full items-center justify-evenly gap-10">
                <a class="w-full flex justify-center items-center h-9 px-3 py-2 rounded-md border border-border hover:bg-gray-100 transition-colors duration-200">
                    <img alt="Google" class="h-6 w-6 mx-auto" src="Images/Auth/google.svg"/>
                </a>
                <a class="w-full flex justify-center items-center h-9 px-3 py-2 rounded-md border border-border hover:bg-gray-100 transition-colors duration-200">
                    <img alt="Microsoft" class="h-6 w-6 mx-auto" src="Images/Auth/microsoft.svg"/>
                </a>
            </div>
            <h3 class="m-auto text-muted-foreground">Or continue with email</h3>
            <label for="register-name">Name</label>
            <input type="text" class="pl-3 h-9 rounded-md shadow-md border border-border" id="register-name" name="name"
                   placeholder="your name" @bind="Command.Name" @bind:event="oninput"/>
            <label for="register-surname">Surname</label>
            <input type="text" class="pl-3 h-9 rounded-md shadow-md border border-border" id="register-surname" name="surname"
                   placeholder="your surname" @bind="Command.Surname" @bind:event="oninput"/>
            <label for="register-email">Email</label>
            <input type="email" class="pl-3 h-9 rounded-md shadow-md border border-border" id="register-email" name="email"
                   placeholder="name@example.com" @bind="Command.Email" @bind:event="oninput"/>
            <label for="register-password">Password</label>
            <input type="password" class="pl-3 h-9 rounded-md shadow-md border border-border" id="register-password" name="password"
                   placeholder="..." @bind="Command.Password" @bind:event="oninput"/>
            <label for="register-confirm-password">Confirm password</label>
            <input type="password" class="pl-3 h-9 rounded-md shadow-md border border-border" id="register-confirm-password"
                   name="confirmPassword"
                   placeholder="..." @bind="Command.ConfirmPassword" @bind:event="oninput"/>
            <button type="submit" disabled="@_busy"
                    class="mt-3 flex justify-center h-9 items-center gap-1 text-primary rounded-md shadow-md border border-border hover:bg-primary-foreground transition-colors duration-200">
                <Blazicon Svg="GoogleMaterialFilledIcon.Login"></Blazicon>
                Sign Up
            </button>
        </form>
    </div>

</div>

@code{
    private RegisterCustomerCommand Command { get; set; } = new();
    private bool _busy;

    private async Task OnValidSubmit()
    {
        if (_busy) return;
        _busy = true;

        try
        {
            var validator = new RegisterCustomerCommandValidator();
            var validationResult = await validator.ValidateAsync(Command);
            if (!validationResult.IsValid)
            {
                Toast.ShowError(ToastErrors.FromValidation(validationResult));
                return;
            }

            var result = await Js.InvokeAsync<AuthPostResult>("authPost", "/api/auth/register", new
            {
                name = Command.Name,
                surname = Command.Surname,
                email = Command.Email,
                password = Command.Password,
                confirmPassword = Command.ConfirmPassword,
            });

            if (!result.Ok)
            {
                Toast.ShowError(ToastErrors.FromPayload(result.Payload, "Registration failed"));
                return;
            }

            Toast.ShowSuccess("Account created");
            Nav.NavigateTo("/", forceLoad: true);
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed record AuthPostResult(bool Ok, int Status, JsonElement? Payload);
}
