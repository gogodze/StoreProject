<div class="sticky top-0 z-50 bg-background/10 backdrop-blur-md text-foreground border-b border-border">
    <div class="container mx-auto flex items-center justify-between p-3">
        <div class="flex items-center justify-between w-full gap-4 lg:w-auto">
            <button class="lg:hidden p-2" onclick="window.toggleNav()">
                <Blazicon Svg='GoogleMaterialRoundIcon.Menu.WithSize("150%")' class="text-primary"/>
            </button>
            <div id="nav-left"
                 class="w-full hidden gap-3 mt-3 flex-col lg:flex lg:flex-row lg:justify-center lg:items-center lg:gap-5 lg:mt-0 lg:w-auto text-[15px]">
                <NavLink href="/" Match="NavLinkMatch.All"
                         class="flex items-center gap-2 text-muted-foreground hover:text-primary transition-colors"
                         ActiveClass="!text-primary font-bold">
                    <Blazicon Svg='GoogleMaterialRoundIcon.Home.WithSize("200%")'/>
                    <span>Home</span>
                </NavLink>
                <NavLink href="/About"
                         class="text-muted-foreground hover:text-primary transition-colors"
                         ActiveClass="!text-primary font-bold">
                    About us
                </NavLink>
                <NavLink href="/FAQ"
                         class="text-muted-foreground hover:text-primary transition-colors"
                         ActiveClass="!text-primary font-bold">
                    FAQ
                </NavLink>
                <NavLink href="/Contact"
                         class="text-muted-foreground hover:text-primary transition-colors"
                         ActiveClass="!text-primary font-bold">
                    Contact
                </NavLink>
            </div>
        </div>

        <div class="flex items-center gap-3 text-[15px]">
            <button
                class="relative p-2 flex items-center justify-center rounded-md text-muted-foreground hover:text-primary hover:bg-primary-foreground transition-colors"
                onclick="window.toggleTheme()">
                <Blazicon Svg='GoogleMaterialRoundIcon.DarkMode.WithSize("110%")'
                          class="absolute rotate-0 dark:rotate-90 opacity-100 dark:opacity-0"/>
                <Blazicon Svg='GoogleMaterialRoundIcon.LightMode.WithSize("110%")'
                          class="absolute dark:rotate-0 rotate-90 dark:opacity-100 opacity-0"/>
            </button>

            <a href="/Login"
               class="shadow-md hidden lg:block px-3 py-2 font-bold border border-border rounded-md text-primary hover:bg-primary-foreground transition-colors">
                Login
            </a>
            <a href="/Register"
               class="shadow-md hidden lg:block px-3 py-2 font-bold border border-border rounded-md text-secondary bg-[#108a37] hover:bg-[#1aa65f] transition-colors">
                Sign Up
            </a>
        </div>
    </div>
</div>

